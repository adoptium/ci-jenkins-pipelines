// Single job: cron triggers tip-only build; SCM change triggers full build.
// For full builds, previously published versioned artifacts are preserved
// (same filename = keep old, regenerate its checksum) so their SHA values
// never change unless the source actually changed.
pipeline {
    agent none
    triggers {
        cron('H 6 * * 1')
        pollSCM('H/15 * * * *')
    }
    parameters {
        choice(name: 'OVERRIDE_TIP_ONLY', choices: ['auto', 'true', 'false'],
               description: 'auto: determined by trigger (cron=tip-only, SCM=full); true/false: force override for testing')
    }
    options {
        buildDiscarder logRotator(daysToKeepStr: '30', numToKeepStr: '10')
    }
    stages {
        stage('Check') {
            agent { label 'dockerBuild&&linux&&x64' }
            steps {
                script {
                    List isTimer    = currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause')
                    boolean isOverride = params.OVERRIDE_TIP_ONLY != 'auto'
                    boolean isRelevantChange = currentBuild.changeSets.any { cs ->
                        cs.items.any { item ->
                            item.affectedFiles.any { f -> f.path.startsWith('tools/code-tools/') }
                        }
                    }
                    if (!isTimer && !isOverride && !isRelevantChange) {
                        currentBuild.result = 'ABORTED'
                        error('No changes in tools/code-tools/ - aborting build.')
                    }
                }
            }
        }
        stage('Build') {
            environment {
                TIP_ONLY = """${
                    params.OVERRIDE_TIP_ONLY == 'auto'
                        ? (currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause') ? 'true' : 'false')
                        : params.OVERRIDE_TIP_ONLY
                }"""
            }
            parallel {
                stage('asmtools') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('asmtools') }
                }
                stage('jcstress') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jcstress') }
                }
                stage('jtreg') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jtreg') }
                }
                stage('jtharness') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jtharness') }
                }
                stage('sigtest') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('sigtest') }
                }
                stage('jcov') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jcov') }
                }
                stage('jmh') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jmh') }
                }
                stage('temurin-sbom') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('temurin-sbom') }
                }
            }
        }
    }
}

void copyLastSuccessfulArtifacts(String stageName) {
    // Find the last successful build that actually archived artifacts for this
    // stage. lastSuccessful() alone is not safe because a build triggered by an
    // SCM change outside tools/code-tools/** skips the Build stage, succeeds
    // with no artifacts, and would then be selected — causing all prior
    // versioned artifacts to be lost.
    script {
        hudson.model.Job job = Jenkins.get().getItemByFullName(env.JOB_NAME)
        hudson.model.Run sourceBuild = null
        if (job != null) {
            for (hudson.model.Run build in job.builds) {
                if (build.number >= currentBuild.number.toInteger()) { continue }
                if (build.result?.toString() != 'SUCCESS') { continue }
                // Check that this build actually has artifacts for this stage
                if (build.artifacts.any { hudson.model.Run.Artifact artifact -> artifact.relativePath.startsWith("${stageName}/") }) {
                    sourceBuild = build
                    break
                }
            }
        }
        if (sourceBuild != null) {
            echo "Copying artifacts from build #${sourceBuild.number} for ${stageName}"
            copyArtifacts(
                projectName: env.JOB_NAME,
                selector: specific("${sourceBuild.number}"),
                filter: "${stageName}/**",
                target: 'previous',
                flatten: false
            )
        } else {
            echo "No previous build with artifacts found for ${stageName} (first run?)"
        }
    }
}

void restoreVersionedArtifacts(String stageName) {
    // 1. Copy all previous versioned artifacts (non-tip) into the stage dir
    //    so they are present regardless of whether they were rebuilt.
    // 2. For any versioned artifact that WAS rebuilt, replace it with the
    //    previous version to keep the SHA stable.
    // Tip artifacts produced by the build are always kept as-is.
    sh """
        set -euo pipefail
        prev_dir="previous/${stageName}"
        if [ ! -d "\${prev_dir}" ]; then
            echo "No previous artifacts directory for ${stageName}, keeping all new artifacts."
            exit 0
        fi

        # Step 1: copy all previous versioned artifacts into the stage dir
        # (this covers the tip-only case where they were never rebuilt)
        find "\${prev_dir}" -maxdepth 1 -type f | while read -r prev_file; do
            filename=\$(basename "\${prev_file}")

            # Never overwrite newly built tip artifacts with old ones.
            # The hex-SHA pattern requires at least one a-f letter so that
            # pure-digit date suffixes like -20240222 are not mistaken for
            # commit SHAs and incorrectly treated as tip artifacts.
            if echo "\${filename}" | grep -qE '(tip|master)' || \
               echo "\${filename}" | grep -qE '-([0-9a-f]*[a-f][0-9a-f]{6,9}|[0-9a-f]{6,9}[a-f][0-9a-f]*)\\.'; then
                echo "TIP artifact, skipping copy from previous: \${filename}"
                continue
            fi

            dest="${stageName}/\${filename}"
            if [ ! -f "\${dest}" ]; then
                echo "VERSIONED not rebuilt, copying from previous: \${filename}"
                cp -f "\${prev_file}" "\${dest}"
            fi
        done

        # Step 2: for versioned artifacts that WERE rebuilt, restore old version
        find "${stageName}" -maxdepth 1 -type f | while read -r new_file; do
            filename=\$(basename "\${new_file}")

            # Always keep new tip artifacts.
            # The hex-SHA pattern requires at least one a-f letter so that
            # pure-digit date suffixes like -20240222 are not mistaken for
            # commit SHAs and incorrectly treated as tip artifacts.
            if echo "\${filename}" | grep -qE '(tip|master)' || \
               echo "\${filename}" | grep -qE '-([0-9a-f]*[a-f][0-9a-f]{6,9}|[0-9a-f]{6,9}[a-f][0-9a-f]*)\\.'; then
                echo "TIP artifact, keeping new: \${filename}"
                continue
            fi

            # Skip checksum files — Step 1 already restored the previous
            # checksum by copying it from previous/ before this loop ran,
            # so the correct old checksum is already in place.
            if echo "\${filename}" | grep -qE '\\.sha256sum\\.txt\$'; then
                continue
            fi

            prev_file="\${prev_dir}/\${filename}"
            if [ -f "\${prev_file}" ]; then
                echo "VERSIONED rebuilt, restoring old: \${filename}"
                cp -f "\${prev_file}" "\${new_file}"
            else
                echo "NEW versioned artifact (not in previous build), keeping: \${filename}"
            fi
        done
    """
}

void build(String stageName) {
    cleanWs()
    docker.image('adoptopenjdk/centos7_build_image').inside {
        try {
            checkout scm

            // Always copy previous artifacts — in tip-only mode the versioned
            // ones are restored as-is; in full mode they are rebuilt then
            // compared and old ones kept where the filename matches.
            copyLastSuccessfulArtifacts(stageName)

            script {
                String toolsUrl = "https://github.com/openjdk/${stageName}"
                if (stageName == 'temurin-sbom') {
                    toolsUrl = 'https://github.com/adoptium/temurin-build.git'
                }
                checkout([$class: 'GitSCM',
                    branches: [[name: 'master']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: stageName]],
                    submoduleCfg: [],
                    userRemoteConfigs: [[url: toolsUrl]]])
            }

            sh label: stageName, script: "./tools/code-tools/${stageName}.sh"

            // Always restore versioned artifacts from previous build:
            //   TIP_ONLY=true  → versioned were not rebuilt, restore all of them
            //   TIP_ONLY=false → versioned were rebuilt, keep old where filename matches
            restoreVersionedArtifacts(stageName)

            archiveArtifacts(
                artifacts: "**/temurin-*-sbom.jar, ${stageName}/*.tar.gz, ${stageName}/${stageName}*.jar, ${stageName}/${stageName}*.jar.*.txt, ${stageName}/${stageName}*.tar.gz.*.txt, ${stageName}/*.tar.gz.*sum*.txt, ${stageName}/*.zip.*sum*.txt, ${stageName}/${stageName}*.jar.html, ${stageName}/${stageName}*.jar.md, ${stageName}/${stageName}*.zip, ${stageName}/javatest*.jar, ${stageName}/javatest*sum*.txt",
                followSymlinks: false
            )
        } catch (hudson.AbortException e) {
            slackSend(channel: 'jenkins', color: 'danger',
                message: "${env.JOB_NAME} : #${env.BUILD_NUMBER} : ${stageName}() FAILED with following error message:\n${e}",
                teamDomain: 'adoptium')
            throw new hudson.AbortException("[ERROR] ${stageName} FAILED\n${e}")
        }
    }
}

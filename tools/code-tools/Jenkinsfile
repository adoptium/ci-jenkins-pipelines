// Single job: cron triggers tip-only build; SCM change triggers full build.
// For full builds, previously published versioned artifacts are preserved
// (same filename = keep old, regenerate its checksum) so their SHA values
// never change unless the source actually changed.
pipeline {
    agent none
    triggers {
        cron('H 6 * * 1')
        pollSCM('H/15 * * * *')
    }
    parameters {
        choice(name: 'OVERRIDE_TIP_ONLY', choices: ['auto', 'true', 'false'],
               description: 'auto: determined by trigger (cron=tip-only, SCM=full); true/false: force override for testing')
    }
    options {
        buildDiscarder logRotator(daysToKeepStr: '30', numToKeepStr: '10')
    }
    stages {
        stage('Check') {
            agent { label 'dockerBuild&&linux&&x64' }
            steps {
                script {
                    List isTimer = currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause')
                    boolean isOverride = params.OVERRIDE_TIP_ONLY != 'auto'
                    boolean isRelevantChange = currentBuild.changeSets.any { cs ->
                        cs.items.any { item ->
                            item.affectedFiles.any { f -> f.path.startsWith('tools/code-tools/') }
                        }
                    }
                    if (!isTimer && !isOverride && !isRelevantChange) {
                        currentBuild.result = 'ABORTED'
                        error('No changes in tools/code-tools/ - aborting build.')
                    }
                }
            }
        }
        stage('Build') {
            environment {
                TIP_ONLY = """${
                    params.OVERRIDE_TIP_ONLY == 'auto'
                        ? (currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause') ? 'true' : 'false')
                        : params.OVERRIDE_TIP_ONLY
                }"""
            }
            parallel {
                stage('asmtools') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('asmtools') }
                }
                stage('jcstress') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jcstress') }
                }
                stage('jtreg') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jtreg') }
                }
                stage('jtharness') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jtharness') }
                }
                stage('sigtest') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('sigtest') }
                }
                stage('jcov') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jcov') }
                }
                stage('jmh') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('jmh') }
                }
                stage('temurin-sbom') {
                    agent { label 'dockerBuild&&linux&&x64' }
                    steps { build('temurin-sbom') }
                }
            }
        }
    }
}

void copyLastSuccessfulArtifacts(String stageName) {
    // The Check stage aborts any build that is not a cron trigger, a manual
    // override, or an SCM change inside tools/code-tools/**. This means every
    // SUCCESS build has actually run the Build stage and archived artifacts,
    // so lastSuccessful() is safe to use here without a raw Jenkins API walk.
    try {
        copyArtifacts(
            projectName: env.JOB_NAME,
            selector: lastSuccessful(),
            filter: "${stageName}/**",
            target: 'previous',
            optional: true,   // no-op on first ever run
            flatten: false
        )
        echo "Copied previous artifacts for ${stageName} into previous/${stageName}/"
    } catch (hudson.AbortException e) {
        echo "No previous artifacts found for ${stageName} (first run?): ${e.message}"
    }
}

void restoreVersionedArtifacts(String stageName) {
    // 1. Copy all previous versioned artifacts into the stage dir,
    //    preserving relative paths. Only copies files not already present
    //    so newly built tip artifacts are never overwritten.
    // 2. For any versioned artifact that WAS rebuilt, restore the previous
    //    version (and its checksum) to keep the SHA stable.
    sh """
        set -euo pipefail
        prev_dir="previous/${stageName}"
        stage_dir="${stageName}"
        if [ ! -d "\${prev_dir}" ]; then
            echo "No previous artifacts directory for ${stageName}, keeping all new artifacts."
            exit 0
        fi

        is_tip() {
            local filename="\$1"
            echo "\${filename}" | grep -qE '(tip|master)' && return 0
            # Hex-SHA: 7-10 hex chars with at least one a-f letter, to avoid
            # matching pure-digit date suffixes like -20240222.
            echo "\${filename}" | grep -qE '-([0-9a-f]*[a-f][0-9a-f]{6,9}|[0-9a-f]{6,9}[a-f][0-9a-f]*)\\.'; return \$?
        }

        # Step 1: copy all previous versioned artifacts into the stage dir.
        find "\${prev_dir}" -type f | while read -r prev_file; do
            rel_path="\${prev_file#\${prev_dir}/}"
            filename=\$(basename "\${rel_path}")

            if is_tip "\${filename}"; then
                echo "TIP artifact, skipping copy from previous: \${rel_path}"
                continue
            fi

            dest="\${stage_dir}/\${rel_path}"
            if [ ! -f "\${dest}" ]; then
                echo "VERSIONED not rebuilt, copying from previous: \${rel_path}"
                mkdir -p "\$(dirname "\${dest}")"
                cp -f "\${prev_file}" "\${dest}"
            fi
        done

        # Step 2: for versioned artifacts that WERE rebuilt, restore old version.
        # Restores both the artifact and its checksum file together to keep
        # them in sync (Step 1 cannot overwrite already-present files).
        find "\${stage_dir}" -type f | while read -r new_file; do
            rel_path="\${new_file#\${stage_dir}/}"
            filename=\$(basename "\${rel_path}")

            if is_tip "\${filename}"; then
                echo "TIP artifact, keeping new: \${rel_path}"
                continue
            fi

            prev_file="\${prev_dir}/\${rel_path}"
            if [ -f "\${prev_file}" ]; then
                echo "VERSIONED rebuilt, restoring old: \${rel_path}"
                cp -f "\${prev_file}" "\${new_file}"
            else
                echo "NEW versioned artifact (not in previous build), keeping: \${rel_path}"
            fi
        done
    """
}

void build(String stageName) {
    cleanWs()
    docker.image('adoptopenjdk/centos7_build_image').inside {
        try {
            checkout scm

            // temurin-sbom has no versioned releases; always keep the new build.
            // For all other tools, copy previous artifacts so versioned ones
            // can be restored (tip-only: all versioned; full: same-filename ones).
            if (stageName != 'temurin-sbom') {
                copyLastSuccessfulArtifacts(stageName)
            }

            script {
                String toolsUrl = "https://github.com/openjdk/${stageName}"
                if (stageName == 'temurin-sbom') {
                    toolsUrl = 'https://github.com/adoptium/temurin-build.git'
                }
                checkout([$class: 'GitSCM',
                    branches: [[name: 'master']],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: stageName]],
                    submoduleCfg: [],
                    userRemoteConfigs: [[url: toolsUrl]]])
            }

            sh label: stageName, script: "./tools/code-tools/${stageName}.sh"

            // Restore versioned artifacts from previous build (skipped for temurin-sbom).
            //   TIP_ONLY=true  → versioned were not rebuilt, restore all of them
            //   TIP_ONLY=false → versioned were rebuilt, keep old where filename matches
            if (stageName != 'temurin-sbom') {
                restoreVersionedArtifacts(stageName)
            }

            archiveArtifacts(
                artifacts: "**/temurin-*-sbom.jar, ${stageName}/*.tar.gz, ${stageName}/${stageName}*.jar, ${stageName}/${stageName}*.jar.*.txt, ${stageName}/${stageName}*.tar.gz.*.txt, ${stageName}/*.tar.gz.*sum*.txt, ${stageName}/*.zip.*sum*.txt, ${stageName}/${stageName}*.jar.html, ${stageName}/${stageName}*.jar.md, ${stageName}/${stageName}*.zip, ${stageName}/javatest*.jar, ${stageName}/javatest*sum*.txt",
                followSymlinks: false
            )
        } catch (hudson.AbortException e) {
            slackSend(channel: 'jenkins', color: 'danger',
                message: "${env.JOB_NAME} : #${env.BUILD_NUMBER} : ${stageName}() FAILED with following error message:\n${e}",
                teamDomain: 'adoptium')
            error("[ERROR] ${stageName} FAILED\n${e}")
        }
    }
}
